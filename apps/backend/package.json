{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/api/server.ts",
    "start": "bun run src/api/server.ts",
    "worker": "bun run src/worker/index.ts",
    "migrate": "bun run src/scripts/migrate.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test tests/",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "RUN_E2E=1 bun test tests/e2e/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@prisma/client": "^6.0.0",
    "@qdrant/js-client-rest": "^1.15.0",
    "@types/cors": "^2.8.19",
    "bullmq": "^5.60.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "ioredis": "^5.9.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "p-limit": "^7.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.9.0"
  }
}
