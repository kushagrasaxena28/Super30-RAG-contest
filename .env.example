# Copy this file to .env and fill in GEMINI_API_KEY. That single key is
# enough to run the whole system - everything else here has a working default
# for `docker compose up`.

# --- Required ---

# Google AI Studio API key. Used for BOTH the LLM calls (classification,
# transcript speaker-labeling, query analysis, answer generation) AND the
# embeddings, which is why one key is all you need.
# Get one at https://aistudio.google.com/apikey - sign in with a Google
# account, "Create API key". No payment method required.
GEMINI_API_KEY=

# --- LLM provider ---
#
# Which model answers questions and does the ingestion-time reasoning.
#   gemini     - default. Free tier, no card needed. Best for evaluating this.
#   anthropic  - Claude. Requires ANTHROPIC_API_KEY and billing set up.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Only needed when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# --- Embedding provider ---
#
# Embeddings sit behind a one-file interface (src/embeddings/). All the
# supported models are 1024-dimension, so the Qdrant collection shape is the
# same either way - but the VECTORS ARE NOT INTERCHANGEABLE. Switching
# providers means dropping the Qdrant collection and re-ingesting; the
# collection carries a {model, dim} marker and refuses to boot against
# vectors produced by a different model rather than silently returning
# nonsense results.
#
#   gemini  - default, reuses GEMINI_API_KEY above.
#   voyage  - Anthropic's recommended embedding partner. NOTE: the free tier
#             without a payment method on file is 3 requests/minute and
#             10,000 tokens/minute, which is too slow to ingest this corpus
#             or to run a live demo. Only pick this with a paid key.
#   jina    - jina-embeddings-v3. Trial key issued with no account or card,
#             but the free allowance is a one-off grant, not a monthly reset.
EMBEDDING_PROVIDER=gemini

# VOYAGE_API_KEY=   # required when EMBEDDING_PROVIDER=voyage
# JINA_API_KEY=     # required when EMBEDDING_PROVIDER=jina

# --- Startup behaviour ---
#
# false (default): the app starts with an EMPTY index. You upload transcripts
# and documents from the chat UI (or POST /api/upload) and watch them get
# classified, chunked and indexed live. This is the intended flow.
#
# true: auto-ingest the bundled dataset in docs/ on boot instead, so the app
# comes up already populated.
BOOTSTRAP_DATASET=false

# --- Infra (defaults match docker-compose.yml service names - only change
#     these if you're running Postgres/Qdrant/Redis somewhere else) ---

DATABASE_URL=postgresql://rag:rag@postgres:5432/casedb
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=case_chunks
REDIS_URL=redis://redis:6379

# --- App config ---

PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS. Leave unset to
# reflect whatever origin made the request - fine for local development.
# CORS_ORIGIN=http://localhost:5173

# Paths inside the backend container where the bundled dataset and uploaded
# files live (see docker-compose.yml volumes). Only used when
# BOOTSTRAP_DATASET=true; uploads always go to UPLOAD_DIR.
INGESTION_DOCS_DIR=/data/docs/docs_for_test
INGESTION_TRANSCRIPTS_DIR=/data/docs/transcriptions_for_test
UPLOAD_DIR=/data/uploads

# How many ingestion jobs the worker processes at once. Bounded by external
# API rate limits, not CPU.
WORKER_CONCURRENCY=3

# Token budget for conversation history before older turns get summarized.
# Deliberately not "80% of the model's context window" - on a 1M-token model
# that would never trigger.
CONVERSATION_TOKEN_BUDGET=120000

# --- Rate limiting ---
#
# Every limit below is a token bucket held in REDIS, not in-process. That
# matters: the worker runs WORKER_CONCURRENCY jobs in parallel and the API
# embeds queries in a separate process, so a per-process limiter would count
# only a fraction of the traffic and the processes would collectively blow
# the provider's limit while each believed it was under it.
#
# The defaults are set to the providers' FREE-TIER limits. Pacing locally to
# them is what keeps ingestion reliable: set them too high and you flood the
# provider, collect 429s, exhaust the retry budget and fail the job.
# Raise them if your key has higher limits.

# Gemini LLM requests. Free tier for gemini-2.5-flash is 10 RPM.
# GEMINI_RATE_LIMIT_RPM=10

# Embedding requests / tokens per minute. Unset uses the selected provider's
# free-tier default (gemini 60, voyage 3, jina 60).
# EMBEDDING_RATE_LIMIT_RPM=
# EMBEDDING_RATE_LIMIT_BURST=
# EMBEDDING_RATE_LIMIT_TPM=

# Anthropic LLM requests - only relevant when LLM_PROVIDER=anthropic.
ANTHROPIC_RATE_LIMIT_RPM=50
# ANTHROPIC_RATE_LIMIT_BURST=

# Per-IP HTTP limits on the two endpoints that cost real money on the way in.
# /api/ask is one query-analysis call plus 1-2 generation calls; each accepted
# /api/upload enqueues a whole ingestion pipeline. Over-limit callers get a
# 429 with a Retry-After header immediately rather than being held open.
ASK_RATE_LIMIT_RPM=10
# ASK_RATE_LIMIT_BURST=
UPLOAD_RATE_LIMIT_RPM=6
# UPLOAD_RATE_LIMIT_BURST=
