# Copy this file to .env and fill in the two API keys below.
# Everything else has a working default for `docker compose up` and does not
# need to change unless you're running things outside Docker.

# --- Required: get these two keys before anything will work ---

# Anthropic API key - used for every LLM call (classification, transcript
# speaker-labeling, query analysis, answer generation).
# Get one at https://console.anthropic.com/settings/keys (requires an
# Anthropic account; new accounts get free trial credit).
ANTHROPIC_API_KEY=

# --- Embeddings: pick ONE provider and set that provider's key ---
#
# Embeddings sit behind a one-file interface (src/embeddings/, see
# plan/04-embeddings-and-storage.md). EMBEDDING_PROVIDER selects which one is
# actually called. All three are 1024-dimension models, so the Qdrant
# collection shape is the same either way - but the VECTORS ARE NOT
# INTERCHANGEABLE. Switching providers means dropping the Qdrant collection
# and re-ingesting; the collection carries a {model, dim} marker and will
# refuse to boot against vectors produced by a different model.
#
#   voyage  - Anthropic's recommended embedding partner. Default.
#   gemini  - Google AI Studio (gemini-embedding-001).
#   jina    - jina-embeddings-v3.
#
# READ THIS BEFORE INGESTING: Voyage's free tier WITHOUT a payment method on
# file is 3 requests/minute and 10,000 tokens/minute. That is not enough to
# ingest this project's ~40K-token corpus in reasonable time, and because
# query embedding shares the same budget it also caps a live demo at ~3
# questions/minute. If you have not attached a card to your Voyage account,
# set EMBEDDING_PROVIDER=gemini (100 RPM free) or =jina (60 RPM free).
EMBEDDING_PROVIDER=voyage

# Voyage AI API key - required when EMBEDDING_PROVIDER=voyage.
# Get one at https://dashboard.voyageai.com/ - sign up, then
# API Keys -> Create new key. See the free-tier caveat above.
VOYAGE_API_KEY=

# Google AI Studio API key - required when EMBEDDING_PROVIDER=gemini.
# Get one at https://aistudio.google.com/apikey - sign in with a Google
# account, "Create API key". No payment method needed; the free tier is
# ~100 requests/minute, comfortably enough for ingestion and a live demo.
# GEMINI_API_KEY=

# Jina AI API key - required when EMBEDDING_PROVIDER=jina.
# Get one at https://jina.ai/embeddings/ - a trial key is issued on the page
# with no account and no card. Free allowance is a one-off token grant rather
# than a monthly reset, so it is best treated as a fallback.
# JINA_API_KEY=

# --- Infra (defaults match docker-compose.yml service names - only change
#     these if you're running Postgres/Qdrant/Redis somewhere else) ---

DATABASE_URL=postgresql://rag:rag@postgres:5432/casedb
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=case_chunks
REDIS_URL=redis://redis:6379

# --- App config ---

PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS. Leave unset to
# reflect whatever origin made the request - fine for local development and
# for the reviewer's own `docker compose up` run.
# CORS_ORIGIN=http://localhost:5173

# Paths inside the backend container where the bundled dataset and uploaded
# files live (see docker-compose.yml volumes) - no need to change these.
INGESTION_DOCS_DIR=/data/docs/docs_for_test
INGESTION_TRANSCRIPTS_DIR=/data/docs/transcriptions_for_test
UPLOAD_DIR=/data/uploads

# How many ingestion jobs the worker processes at once. Bounded by external
# API rate limits, not CPU - 2-3 is a sane default for this corpus size.
WORKER_CONCURRENCY=3

# Token budget for conversation history before older turns get summarized
# (see plan/07-conversation.md - deliberately not "80% of the model's
# context window", which for a 1M-token model would never trigger).
CONVERSATION_TOKEN_BUDGET=120000

# --- Rate limiting (see plan/09-hardening.md section 6) ---
#
# Every limit below is a token bucket held in REDIS, not in-process. That
# matters: the worker runs WORKER_CONCURRENCY jobs in parallel and the API
# embeds queries in a separate process, so a per-process limiter would count
# only a fraction of the traffic and the three of them would collectively blow
# the limit while each believed it was under it.
#
# Each bucket is a pair: *_RPM is the sustained rate (tokens refilled per
# minute), *_BURST is the bucket capacity (how many can be spent at once).
# Leave *_BURST unset and it defaults to the matching *_RPM, i.e. one minute's
# worth available up front.

# Outbound embedding request rate. Leave unset to use the selected provider's
# published free-tier limit: voyage 3/min (deliberately conservative - that is
# the no-payment-method tier), gemini 100/min, jina 60/min. Set it explicitly
# if your account has higher limits.
# EMBEDDING_RATE_LIMIT_RPM=
# EMBEDDING_RATE_LIMIT_BURST=

# Outbound embedding TOKEN rate. On Voyage's free tier this, not the request
# count, is what actually bites: a handful of 64-chunk batches is well inside
# 3 requests/minute and still returns 429 on the 10,000 tokens/minute cap.
# Unset uses the provider default (voyage 10000, gemini 30000, jina none).
# EMBEDDING_RATE_LIMIT_TPM=

# Outbound Anthropic request rate, shared by ingestion (classify, speaker
# label, summarize) and the live /api/ask path.
ANTHROPIC_RATE_LIMIT_RPM=50
# ANTHROPIC_RATE_LIMIT_BURST=

# Per-IP HTTP limits on the two endpoints that cost real money on the way in.
# /api/ask is one query-analysis call plus 1-2 generation calls; each accepted
# /api/upload enqueues a whole ingestion pipeline. Over-limit callers get a
# 429 with a Retry-After header immediately rather than being held open.
ASK_RATE_LIMIT_RPM=10
# ASK_RATE_LIMIT_BURST=
UPLOAD_RATE_LIMIT_RPM=6
# UPLOAD_RATE_LIMIT_BURST=
